		take_shot "$name" "${eye:-left} rect=$rect px=${px:-1024}"
		;;
	panel)
		local name layer eye margin
		read -r name layer eye margin <<<"$rest"
		crop panel "$out/$name.png" "$layer" "${eye:-left}" "${margin:-8}"
		;;
	crop)
		local name x0 y0 x1 y1 dst
		read -r name x0 y0 x1 y1 dst <<<"$rest"
		crop box "$out/$name.png" "$x0" "$y0" "$x1" "$y1" "$out/${dst:-$name.crop}.png"
		;;
	check-projection)
		# shots before/after turning the head about one eye; the fit tells whether the image uses the declared fov
		local eye deg shots=() turn i=0
		read -r eye deg <<<"$rest"
		eye=${eye:-left} deg=${deg:-12}
		printf 'look 0 0 0 %s\n' "$eye" >&3
		sleep 0.5
		take_shot projcheck-0 "$eye world" >/dev/null || return 1
		shots+=("$out/projcheck-0.png")
		for turn in "$deg 0 0" "0 $deg 0" "0 0 $deg"; do
			i=$((i + 1))
			printf 'look %s %s\n' "$turn" "$eye" >&3
			sleep 0.5
			take_shot "projcheck-$i" "$eye world" >/dev/null || return 1
			shots+=("$out/projcheck-$i.png")
		done
		printf 'look 0 0 0 %s\n' "$eye" >&3
		python3 -I "$here/fakexr-projcheck.py" "${shots[@]}"
		;;
	press | hold | release)
		local button secs path
		read -r button secs <<<"$rest"
		path=$(sense_input "$button") || { echo "fakexr-run: unknown Sense button '$button'" >&2; return 1; }
		if [[ $path == none ]]; then
			echo "fakexr-run: $button does not reach the app on the real setup (see the directive help); nothing sent"
			return 0
		fi
		[[ $cmd != release ]] && printf 'input %s 1\n' "$path" >&3
		if [[ $cmd == press ]]; then sleep "${secs:-0.2}"; fi
		[[ $cmd != hold ]] && printf 'input %s 0\n' "$path" >&3
		return 0 # the test above is false for hold, which would end the case with status 1
		;;
	key)
		local win
		win=$(DISPLAY=$display xdotool search --onlyvisible --name '.' 2>/dev/null | head -1)
		[[ -n $win ]] || { echo "fakexr-run: no window on $display for key" >&2; return 1; }
		DISPLAY=$display xdotool windowfocus --sync "$win" key --clearmodifiers $rest
		;;
	stick)
		local hand x y
		read -r hand x y <<<"$rest"
		printf 'input %s thumbstick %s %s\n' "$hand" "${x:-0}" "${y:-0}" >&3
		;;
	mark) mark=$(stat -c %s "$log") ;;
	wait-log | expect-log)
		local regex secs deadline
		if [[ $rest =~ ^\"([^\"]*)\"[[:space:]]*([0-9]*)[[:space:]]*$ ]]; then
			regex=${BASH_REMATCH[1]} secs=${BASH_REMATCH[2]}
		else
			read -r regex secs <<<"$rest"
		fi
		[[ $cmd == expect-log ]] && secs=0
		deadline=$((SECONDS + ${secs:-60}))
		until log_since_mark | grep -qE -- "$regex"; do
			if ((SECONDS >= deadline)) || ! alive; then
				echo "fakexr-run: log never matched '$regex'" >&2
				log_since_mark | tail -20 >&2
				return 1
			fi
			sleep 0.2
		done
		;;
	log)
		if [[ -n $rest ]]; then log_since_mark | grep -E -- "${rest//\"/}" || true; else log_since_mark; fi
		;;
	status)
		local size
		size=$(stat -c %s "$log")
		printf 'status\n' >&3
		for _ in $(seq 1 30); do sleep 0.1; tail -c +$((size + 1)) "$log" | grep -q 'fakexr: status' && break; done
		sleep 0.1
		tail -c +$((size + 1)) "$log" | sed -n '/fakexr: status/,$p' | grep '^fakexr:'
		;;
	include)
		local file=$rest
		[[ $file == /* ]] || { [[ -f $dir/$file ]] && file=$dir/$file || file=$here/scenarios/$file; }
		run_file "$file" || return
		;;
	*) echo "fakexr-run: unknown directive '$cmd'" >&2; return 1 ;;
	esac
}

run_file() {
	local file=$1 lineno=0 line
	[[ -f $file ]] || { echo "fakexr-run: no scenario $file" >&2; return 1; }
	while IFS= read -r line || [[ -n $line ]]; do
		lineno=$((lineno + 1))
		directive "$line" "$(dirname "$file")" || { echo "fakexr-run: failed at ${file##*/}:$lineno: $line" >&2; return 1; }
	done <"$file"
}

quit_game() {
	if alive; then
		printf 'quit\n' >&4
		for _ in $(seq 1 100); do alive || break; sleep 0.1; done
	fi
	game_pid=
}

if ((serve)); then
	# requests: "<id>\t<directive>" lines on $out/ctl/in; answer: $out/ctl/<id>.out + <id>.rc (written last)
	rm -rf "$ctl_dir"
	mkdir -p "$ctl_dir"
	mkfifo "$ctl_dir/in"
	exec 5<>"$ctl_dir/in"
	echo $$ >"$out/serve.pid"
	echo "fakexr-run: serving; send directives with: $here/fakexr-ctl -o $out <directive>"
	while alive; do
		IFS=$'\t' read -r -t 1 id line <&5 || continue
		if [[ $line == stop ]]; then
			echo 0 >"$ctl_dir/$id.rc.tmp" && : >"$ctl_dir/$id.out" && mv "$ctl_dir/$id.rc.tmp" "$ctl_dir/$id.rc"
			break
		fi
		rc=0
		directive "$line" "$PWD" >"$ctl_dir/$id.out" 2>&1 || rc=$?
		echo "$rc" >"$ctl_dir/$id.rc.tmp"
		mv "$ctl_dir/$id.rc.tmp" "$ctl_dir/$id.rc"
	done
	alive || { echo "fakexr-run: the game exited" >&2; tail -20 "$log" >&2; }
	quit_game
	echo "fakexr-run: done"
	exit 0
fi

rc=0
run_file "$scenario" || rc=1
quit_game
echo "fakexr-run: done"
exit $rc
