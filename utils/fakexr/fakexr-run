#!/usr/bin/env bash
# Run the engine against the fake OpenXR runtime in a hidden X server and play a scenario.
#
# Usage: fakexr-run <game-root> <scenario> [xash args...]
#   game-root  a COPY of the game tree (xash3d + game folders); the real install is refused
#              unless FAKEXR_ALLOW_LIVE=1, because the game writes configs and saves into it
#   scenario   text file, one directive per line:
#                xr <command>          fakexr control command (head/aim/grip/track/input/exit, see fakexr.c)
#                con <command>         engine console command (via -stdincmd)
#                sleep <seconds>
#                shot <name> [both|left|right]   composited view -> $FAKEXR_OUT/<name>.png (waits for it)
#                wait-log <regex> [seconds]       wait until the game log matches (default 60 s)
#                # comment
#   Lines may use $OUT (the output directory).
#
# Environment: FAKEXR_OUT (default ./fakexr-out), FAKEXR_GAME (default valve), FAKEXR_DISPLAY (use this X display
# instead of starting Xvfb), FAKEXR_SCREEN (Xvfb screen, default 1280x720x24), plus the runtime's own FAKEXR_*.
# The game's output goes to $FAKEXR_OUT/game.log.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
json=$here/build/fakexr32/fakexr.json
[[ $# -ge 2 ]] || { sed -n '2,20p' "$0"; exit 2; }
root=$(cd "$1" && pwd)
scenario=$(realpath "$2")
shift 2

[[ -f $json ]] || { echo "fakexr-run: build the runtime first (make -C $here)" >&2; exit 1; }
[[ -x $root/xash3d ]] || { echo "fakexr-run: no $root/xash3d" >&2; exit 1; }
if [[ $root == "$(realpath -m "$HOME/Games/lambda1vr-pc")" && ${FAKEXR_ALLOW_LIVE:-} != 1 ]]; then
	echo "fakexr-run: $root is the real install; use a copy (or FAKEXR_ALLOW_LIVE=1)" >&2
	exit 1
fi

out=$(realpath -m "${FAKEXR_OUT:-./fakexr-out}")
mkdir -p "$out"
log=$out/game.log
: >"$log"
work=$(mktemp -d "${TMPDIR:-/tmp}/fakexr.XXXXXX")
xr_fifo=$work/xr.fifo
con_fifo=$work/console.fifo
mkfifo "$xr_fifo" "$con_fifo"

xvfb_pid= game_pid=
cleanup() {
	[[ -n $game_pid ]] && kill "$game_pid" 2>/dev/null || true
	[[ -n $xvfb_pid ]] && kill "$xvfb_pid" 2>/dev/null || true
	exec 3>&- 4>&- 2>/dev/null || true
	rm -f "$xr_fifo" "$con_fifo"
	rmdir "$work" 2>/dev/null || true
}
trap cleanup EXIT

display=${FAKEXR_DISPLAY:-}
if [[ -z $display ]]; then
	for n in $(seq 91 120); do
		[[ -e /tmp/.X$n-lock || -e /tmp/.X11-unix/X$n ]] && continue
		display=:$n
		break
	done
	[[ -n $display ]] || { echo "fakexr-run: no free X display" >&2; exit 1; }
	Xvfb "$display" -screen 0 "${FAKEXR_SCREEN:-1280x720x24}" -nolisten tcp >"$out/xvfb.log" 2>&1 &
	xvfb_pid=$!
	for _ in $(seq 1 50); do [[ -e /tmp/.X11-unix/X${display#:} ]] && break; sleep 0.1; done
fi

# Both FIFOs opened read-write so neither side blocks or sees EOF.
exec 3<>"$xr_fifo" 4<>"$con_fifo"
game=${FAKEXR_GAME:-valve}
(
	cd "$root"
	exec env DISPLAY="$display" LD_LIBRARY_PATH="$root${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
		XR_RUNTIME_JSON="$json" FAKEXR_CONTROL="$xr_fifo" \
		./xash3d -game "$game" +set vr_enable 1 +set gl_vsync 0 +set fps_max 0 -console -log -stdincmd \
		-width 1280 -height 720 -windowed "$@" <"$con_fifo" >>"$log" 2>&1
) &
game_pid=$!
echo "fakexr-run: game pid $game_pid on $display, output in $out"

alive() { kill -0 "$game_pid" 2>/dev/null; }

lineno=0
while IFS= read -r line || [[ -n $line ]]; do
	lineno=$((lineno + 1))
	line=${line//\$OUT/$out}
	[[ -z ${line//[[:space:]]/} || $line == \#* ]] && continue
	alive || { echo "fakexr-run: game exited before line $lineno: $line" >&2; tail -20 "$log" >&2; exit 1; }
	read -r cmd rest <<<"$line"
	case $cmd in
	xr) printf '%s\n' "$rest" >&3 ;;
	con) printf '%s\n' "$rest" >&4 ;;
	sleep) sleep "$rest" ;;
	shot)
		read -r name eyes <<<"$rest"
		file=$out/$name.png
		rm -f "$file"
		printf 'shot %s %s\n' "$file" "${eyes:-both}" >&3
		for _ in $(seq 1 300); do [[ -f $file ]] && break; alive || break; sleep 0.1; done
		if [[ -f $file ]]; then echo "fakexr-run: $file"; else echo "fakexr-run: shot $name timed out" >&2; fi
		;;
	wait-log)
		if [[ $rest =~ ^\"([^\"]*)\"[[:space:]]*([0-9]*)[[:space:]]*$ ]]; then
			regex=${BASH_REMATCH[1]} secs=${BASH_REMATCH[2]}
		else
			read -r regex secs <<<"$rest"
		fi
		deadline=$((SECONDS + ${secs:-60}))
		until grep -qE -- "$regex" "$log"; do
			if ((SECONDS >= deadline)) || ! alive; then
				echo "fakexr-run: line $lineno: log never matched '$regex'" >&2
				tail -20 "$log" >&2
				exit 1
			fi
			sleep 0.2
		done
		;;
	*) echo "fakexr-run: line $lineno: unknown directive '$cmd'" >&2; exit 1 ;;
	esac
done <"$scenario"

if alive; then
	printf 'quit\n' >&4
	for _ in $(seq 1 100); do alive || break; sleep 0.1; done
fi
game_pid=
echo "fakexr-run: done"
