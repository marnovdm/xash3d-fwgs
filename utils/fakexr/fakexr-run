#!/usr/bin/env bash
# Run the engine against the fake OpenXR runtime in a hidden X server and play a scenario.
#
# Usage: fakexr-run <game-root|live> <scenario> [xash args...]     play a scenario file, then quit
#        fakexr-run --serve <game-root|live> [xash args...]        keep the game up; send directives with fakexr-ctl
#        fakexr-run [--serve] --app <dir> [<scenario>] <program> [args...]
#                   any other OpenXR (or, with FAKEXR_OPENVR, OpenVR) program, started in <dir> with its own $HOME
#                   in $OUT/home (configs/saves land there); "con" lines go to its stdin. FAKEXR_OPENVR=<OpenVR
#                   runtime dir, e.g. xrizer's target/release> = OpenVR -> OpenXR bridge for this process only
#                   (VR_OVERRIDE + an openvrpaths.vrpath in the fake home; the real SteamVR setup is not touched).
#   game-root  live = the installed game (~/Games/lambda1vr-pc, or $FAKEXR_LIVE), used READ-ONLY: a thin root of
#              symlinked binaries in $FAKEXR_OUT/root takes all writes (configs, saves) and the engine reads the
#              game data from the install through -rodir. Or a COPY of the game tree (the real install itself is
#              refused). Either way the game runs in a bubblewrap sandbox in which $HOME is read-only except the
#              output and cache directories (and a copied root), so it cannot touch the install, its settings or saves.
#   Directives, one per line (# comments; $OUT = the output directory):
#     xr <command>                  fakexr control command (head/aim/grip/move/look/vel/track/input/fov/state/status/exit)
#     con <command>                 engine console command (via -stdincmd)
#     sleep <seconds>
#     shot <name> [both|left|right] [layers] [world] [rect=x0,y0,x1,y1] [px=<width>]
#                                   composited view -> $OUT/<name>.png + <name>.json (layer poses, spaces and where
#                                   each panel lands in the PNG); "layers" also writes each quad image to <name>.layerN.png;
#                                   rect = only that part of the eye (normal-shot pixels), re-rendered with px as the longer side;
#                                   world = the 3D view only, without the panels
#     zoom <name> <shot> <layer> [left|right] [px] [margin %]
#                                   re-render the area of a panel seen in an earlier shot, sharp (default 1024 px on the longer side)
#     panel <shot> <layer> [left|right] [<margin px>]
#                                   crop one quad layer out of a shot (box from the json) -> <shot>.panel<layer>.png
#     crop <shot> <x0> <y0> <x1> <y1> [<out name>]   crop a pixel box out of a shot
#     mark                          later wait-log/expect-log/log only look at game output after this point
#     wait-log "<regex>" [seconds]  wait until the game log matches (default 60 s)
#     expect-log "<regex>"          fail unless the log already matches
#     log [<regex>]                 print the game log since the mark (lines matching regex)
#     status                        print the runtime's poses, inputs, session state, measured fps and the projection
#                                   check (every frame: submitted fov/eye pose/pixel aspect vs what was handed out;
#                                   mismatches are logged as "fakexr: projection mismatch")
#     check-projection [left|right] [degrees]
#                                   shoot the 3D view, turn the head about that eye (pitch, yaw, roll; default 12)
#                                   and check that the images line up under the declared projection (catches an app
#                                   that renders with another field of view or aspect ratio than it declares)
#     include <file>                run another scenario file (relative to this one, or utils/fakexr/scenarios/)
#     press <sense button> [seconds]  PS VR2 Sense button as SteamVR + Sony's driver deliver it to OpenXR apps (Touch
#                                   profile): cross/circle = right a/b, square/triangle = left x/y, l2/r2 = trigger,
#                                   l1/r1 = grip, l3/r3 = stick click, menu = left menu. options/create/ps reach no app
#                                   (Options feeds a path the generated Touch binding does not listen to; Create =
#                                   SteamVR screenshot; PS = system): logged, nothing sent. Default 0.2 s.
#     hold <sense button> / release <sense button>
#     stick left|right <x> <y>      thumbstick deflection (0 0 = centre)
#     key <keysym...>               real key presses into the game's window on the hidden display (xdotool), e.g.
#                                   key Return; key ctrl+alt+grave
#
# Environment: FAKEXR_OUT (default ./fakexr-out), FAKEXR_GAME (default: -game from the args, else valve),
# FAKEXR_DISPLAY (use this X display instead of starting Xvfb), FAKEXR_SCREEN (Xvfb screen, default 1280x720x24),
# FAKEXR_GPU (1 = render on the GPU through VirtualGL, 0 = llvmpipe; default: GPU when vglrun is installed and
# the desktop X server in $DISPLAY is reachable; FAKEXR_VGL_DEVICE overrides the 3D X server; on the GPU
# FAKEXR_EYE_SIZE defaults to 2884, SteamVR's real width here, instead of 960),
# FAKEXR_AUDIO (1 = real audio output; default silent: SDL dummy, OpenAL null, no PulseAudio/PipeWire), FAKEXR_DBUS (1 = give the program the desktop's
# D-Bus session; default none, so it cannot inhibit/wake the screensaver), FAKEXR_OVERLAY (directory copied over
# the thin root, e.g. freshly built libxash.so or valve/cl_dlls/client.so to test without installing),
# FAKEXR_ALLOW_DURING_VR (1 = run even while SteamVR runs; default refuse: GPU load + virtual gamepads would
# disturb a VR game), FAKEXR_CACHE (shader/font cache, default ~/.cache/fakexr), FAKEXR_SENSE_DEVICES (0 = no virtual PS VR2 Sense
# controllers as evdev gamepads; default on, like the real controllers over Bluetooth), plus the runtime's own FAKEXR_*.
# The game's output goes to $OUT/game.log.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
json=$here/build/fakexr32/fakexr.json
live=$(realpath -m "${FAKEXR_LIVE:-$HOME/Games/lambda1vr-pc}")
usage() { sed -n '2,41p' "$0"; exit 2; }

serve=0 app=
while [[ ${1:-} == --* ]]; do
	case $1 in
	--serve) serve=1; shift ;;
	--app) [[ $# -ge 2 ]] || usage; app=$(cd "$2" && pwd); shift 2 ;;
	*) usage ;;
	esac
done
root_arg=
if [[ -z $app ]]; then
	[[ $# -ge $((serve ? 1 : 2)) ]] || usage
	root_arg=$1
	shift
fi
scenario=
if ((!serve)); then
	[[ $# -ge 1 ]] || usage
	scenario=$(realpath "$1")
	shift
fi
[[ -z $app || $# -ge 1 ]] || usage

[[ -f $json ]] || { echo "fakexr-run: build the runtime first (make -C $here)" >&2; exit 1; }
command -v bwrap >/dev/null || { echo "fakexr-run: bubblewrap (bwrap) is required for the write guard" >&2; exit 1; }
# a test renders a full PS VR2 stereo image at 120 fps on the same GPU and plugs in two (idle) virtual gamepads:
# it would cost a running VR game frames (reprojection) and may make it see extra controllers
if pgrep -x vrcompositor >/dev/null && [[ ${FAKEXR_ALLOW_DURING_VR:-0} != 1 ]]; then
	echo "fakexr-run: SteamVR is running (a VR game may be in use): not starting a test (FAKEXR_ALLOW_DURING_VR=1 overrides)" >&2
	exit 1
fi

out=$(realpath -m "${FAKEXR_OUT:-./fakexr-out}")
mkdir -p "$out"
cache=$(realpath -m "${FAKEXR_CACHE:-$HOME/.cache/fakexr}")
mkdir -p "$cache"

# ---- game root ----
rodir=
if [[ -n $app ]]; then
	root=$app
	program=$1
	shift
	[[ $program == */* ]] || program=./$program
	( cd "$root" && [[ -x $program ]] ) || { echo "fakexr-run: no executable $program in $root" >&2; exit 1; }
	# the runtime must match the program's word size
	if file -L "$root/$program" 2>/dev/null | grep -q 'ELF 64-bit'; then json=$here/build/fakexr64/fakexr.json; fi
	[[ -f $json ]] || { echo "fakexr-run: build the runtime first (make -C $here)" >&2; exit 1; }
elif [[ $root_arg == live ]]; then
	[[ -x $live/xash3d ]] || { echo "fakexr-run: no game at $live" >&2; exit 1; }
	root=$out/root
	mkdir -p "$root"
	# fresh symlinks to the installed binaries every run (stale ones and overlay copies are replaced)
	find "$root" -maxdepth 1 -type l -delete
	for f in "$live"/*; do
		name=${f##*/}
		[[ -f $f && ( $name == xash3d || $name == *.so || $name == *.so.* ) && $name != *.bak* ]] || continue
		rm -f "$root/$name"
		ln -s "$f" "$root/$name"
	done
	# the engine mounts <game>/custom/ and <game>_hd/_addon/_lv/... only from the writable root, not from
	# -rodir: link them in (cstrike/custom/extras.pk3 holds the CS VR models and bot profiles). They stay
	# read-only in the sandbox.
	for d in "$live"/*/; do
		d=${d%/}
		name=${d##*/}
		if [[ -f $d/liblist.gam || -f $d/gameinfo.txt ]]; then
			[[ -d $d/custom ]] || continue
			mkdir -p "$root/$name"
			[[ -L $root/$name/custom || ! -e $root/$name/custom ]] && ln -sfn "$d/custom" "$root/$name/custom"
		elif [[ ! -e $root/$name || -L $root/$name ]]; then
			ln -sfn "$d" "$root/$name"
		fi
	done
	rodir=$live
else
	root=$(cd "$root_arg" && pwd)
	[[ -x $root/xash3d ]] || { echo "fakexr-run: no $root/xash3d" >&2; exit 1; }
	if [[ $root == "$live" ]]; then
		echo "fakexr-run: $root is the real install; pass 'live' (read-only) or use a copy" >&2
		exit 1
	fi
fi
if [[ -n ${FAKEXR_OVERLAY:-} && -z $app ]]; then
	cp -rT --remove-destination "$FAKEXR_OVERLAY" "$root"
	echo "fakexr-run: overlay $FAKEXR_OVERLAY copied into $root"
fi

# ---- game, -game ----
game=${FAKEXR_GAME:-}
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
	if [[ ${args[i]} == -game && $((i + 1)) -lt ${#args[@]} ]]; then
		game=${args[i + 1]}
		args=("${args[@]:0:i}" "${args[@]:i+2}")
		break
	fi
done
game=${game:-valve}
[[ -n $app ]] && game=${program##*/}

# ---- a fake $HOME for --app programs (their configs and saves), and the optional OpenVR bridge ----
app_env=()
if [[ -n $app ]]; then
	home=$out/home
	mkdir -p "$home/.config" "$home/.local/share"
	app_env=(HOME="$home" XDG_CONFIG_HOME="$home/.config" XDG_DATA_HOME="$home/.local/share")
	if [[ -n ${FAKEXR_OPENVR:-} ]]; then
		openvr=$(cd "$FAKEXR_OPENVR" && pwd)
		mkdir -p "$home/.config/openvr"
		printf '{\n\t"jsonid": "vrpathreg",\n\t"runtime": [ "%s" ],\n\t"config": [ "%s" ],\n\t"log": [ "%s" ],\n\t"version": 1\n}\n' \
			"$openvr" "$home/.config/openvr" "$out" >"$home/.config/openvr/openvrpaths.vrpath"
		# an OpenVR bridge talks OpenXR 1.1 and asks the refresh rate through XR_FB_display_refresh_rate
		app_env+=(VR_OVERRIDE="$openvr" FAKEXR_API_MAX="${FAKEXR_API_MAX:-1.1}" FAKEXR_REFRESH_EXT=1)
	fi
fi

log=$out/game.log
: >"$log"
work=$(mktemp -d "${TMPDIR:-/tmp}/fakexr.XXXXXX")
xr_fifo=$work/xr.fifo
con_fifo=$work/console.fifo
mkfifo "$xr_fifo" "$con_fifo"
ctl_dir=$out/ctl

xvfb_pid= game_pid= sense_pid=
cleanup() {
	[[ -n $game_pid ]] && kill "$game_pid" 2>/dev/null || true
	[[ -n $sense_pid ]] && kill "$sense_pid" 2>/dev/null || true
	[[ -n $xvfb_pid ]] && kill "$xvfb_pid" 2>/dev/null || true
	exec 3>&- 4>&- 5>&- 2>/dev/null || true
	rm -f "$xr_fifo" "$con_fifo" "$out/serve.pid" "$work/sense-ready"
	rmdir "$work" 2>/dev/null || true
	if [[ -n $rodir ]]; then
		# belt and braces next to the sandbox: report anything in the install newer than this run's start
		changed=$(find "$rodir" -newer "$out/.run-start" -not -name console.fifo -not -name engine.log \
			-not -name lambda1vr-pc.log -not -name lambda1vr-relaunch.log 2>/dev/null | head -5)
		[[ -z $changed ]] || echo "fakexr-run: WARNING, changed in the install during the run (the game may have been played):
$changed" >&2
	fi
}
trap cleanup EXIT
touch "$out/.run-start"

display=${FAKEXR_DISPLAY:-}
if [[ -z $display ]]; then
	for n in $(seq 91 120); do
		[[ -e /tmp/.X$n-lock || -e /tmp/.X11-unix/X$n ]] && continue
		display=:$n
		break
	done
	[[ -n $display ]] || { echo "fakexr-run: no free X display" >&2; exit 1; }
	Xvfb "$display" -screen 0 "${FAKEXR_SCREEN:-1280x720x24}" -nolisten tcp >"$out/xvfb.log" 2>&1 &
	xvfb_pid=$!
	for _ in $(seq 1 50); do [[ -e /tmp/.X11-unix/X${display#:} ]] && break; sleep 0.1; done
fi

# ---- GPU through VirtualGL: the game's window stays in Xvfb, its GL runs on the GPU ----
# VirtualGL's GLX back end renders through the desktop's X server ($DISPLAY, usually :0) into hidden pbuffers
# (nothing appears on the monitors). Its EGL back end (-d egl, needs no X server) is NOT used by default: with
# VirtualGL 3.1.5 it hands the runtime the first rendered image of each swapchain forever (the engine renders
# into its own framebuffers, which that back end mishandles), so every shot is stale.
gpu=${FAKEXR_GPU:-auto}
vgl=()
vgl_device=${FAKEXR_VGL_DEVICE:-}
if [[ $gpu != 0 ]]; then
	if ! command -v vglrun >/dev/null; then
		[[ $gpu == 1 ]] && { echo "fakexr-run: FAKEXR_GPU=1 needs virtualgl + lib32-virtualgl" >&2; exit 1; }
		gpu=0
	elif [[ -z $vgl_device ]]; then
		if [[ -n ${DISPLAY:-} ]] && xset -display "$DISPLAY" q >/dev/null 2>&1; then
			vgl_device=$DISPLAY
		else
			[[ $gpu == 1 ]] && { echo "fakexr-run: GPU needs a reachable X server in \$DISPLAY (or FAKEXR_VGL_DEVICE)" >&2; exit 1; }
			echo "fakexr-run: no X server reachable for VirtualGL, rendering on llvmpipe" >&2
			gpu=0
		fi
	fi
fi
if [[ $gpu != 0 ]]; then
	gpu=1
	vgl=(vglrun -d "$vgl_device")
	# VirtualGL copies the game's desktop window back into Xvfb every frame; the headset images come straight from
	# the swapchains, so skip that: Doom 3 VR went from ~100 to the full 119.88 fps (FAKEXR_VGL_READBACK=1 keeps it,
	# e.g. to screenshot the game's own window)
	[[ ${FAKEXR_VGL_READBACK:-0} == 1 ]] || export VGL_READBACK=none
	# VirtualGL renders through the desktop's X server: note whether it is blanked or locked (Source games under
	# Proton stalled on the real desktop while the screensaver was up; whether GLX pbuffers do is being checked)
	desk_state=$(xset -display "$vgl_device" q 2>/dev/null | sed -n 's/^ *Monitor is //p')
	if [[ $(dbus-send --session --print-reply --dest=org.freedesktop.DBus /org/freedesktop/DBus \
		org.freedesktop.DBus.NameHasOwner string:org.cinnamon.ScreenSaver 2>/dev/null | awk '/boolean/ { print $2 }') == true ]]; then
		# only ask a running screensaver (GetActive would D-Bus-activate it otherwise)
		[[ $(dbus-send --session --print-reply --dest=org.cinnamon.ScreenSaver /org/cinnamon/ScreenSaver \
			org.cinnamon.ScreenSaver.GetActive 2>/dev/null | awk '/boolean/ { print $2 }') == true ]] && desk_state+=", screensaver/lock active"
	fi
	echo "fakexr-run: desktop $vgl_device for VirtualGL: monitor ${desk_state:-unknown}" >&2
	# the GPU keeps up with the real thing: SteamVR asks for 2884x2940 per eye on this PC (llvmpipe does not)
	export FAKEXR_EYE_SIZE=${FAKEXR_EYE_SIZE:-2884}
fi

# ---- the PS VR2 Sense controllers as the desktop sees them (evdev game controllers, like the real ones over
# Bluetooth): games find them through SDL, as they do on the real setup (Doom 3 BFG VR crashed with them present
# while headless runs had none). System-wide while the run lasts. FAKEXR_SENSE_DEVICES=0 = none.
if [[ ${FAKEXR_SENSE_DEVICES:-1} != 0 ]]; then
	if [[ -w /dev/uinput ]] && python3 -c 'import evdev' 2>/dev/null; then
		"$here/fakexr-sense-devices" --ready-file "$work/sense-ready" >"$out/sense-devices.log" 2>&1 &
		sense_pid=$!
		for _ in $(seq 1 30); do [[ -e $work/sense-ready ]] && break; sleep 0.1; done
		sleep 0.5 # let udev give the new nodes their permissions
		[[ -e $work/sense-ready ]] || echo "fakexr-run: virtual Sense controllers did not start (see sense-devices.log)" >&2
	else
		echo "fakexr-run: no virtual Sense controllers (needs a writable /dev/uinput and python-evdev)" >&2
	fi
fi

# ---- sandbox: $HOME read-only except what this run may write ----
sandbox=(bwrap --dev-bind / / --ro-bind "$HOME" "$HOME" --bind "$out" "$out" --bind "$cache" "$cache" --die-with-parent)
[[ -n $rodir ]] && sandbox+=(--ro-bind "$rodir" "$rodir")
# a copied game root is writable; an --app folder stays read-only (the program writes to its fake $HOME)
[[ $root != "$out"/* && -z $app ]] && sandbox+=(--bind "$root" "$root")

# Both FIFOs opened read-write so neither side blocks or sees EOF.
exec 3<>"$xr_fifo" 4<>"$con_fifo"
if [[ -n $app ]]; then
	xash=("$program")
	# programs that only print through stdio buffer fully into a pipe: line-buffer them so the log is live
	command -v stdbuf >/dev/null && xash=(stdbuf -oL -eL "$program")
else
	xash=(./xash3d -game "$game" +set vr_enable 1 +set gl_vsync 0 +set fps_max 0 -console -log -stdincmd
		-width 1280 -height 720 -windowed)
	[[ -n $rodir ]] && xash+=(-rodir "$rodir")
fi
(
	cd "$root"
	# SDL otherwise tickles org.freedesktop.ScreenSaver on the desktop's session bus (SimulateUserActivity),
	# which wakes the real, blanked monitors although the game draws into Xvfb
	# silent by default, whatever the program uses: SDL's dummy driver, OpenAL Soft's null backend, and unreachable
	# PulseAudio/PipeWire servers for anything else (an OpenAL game, Doom 3 BFG VR / SelacoVR, otherwise played on the
	# desktop's speakers)
	audio=()
	[[ ${FAKEXR_AUDIO:-0} == 1 ]] || audio=(SDL_AUDIODRIVER=dummy ALSOFT_DRIVERS=null
		PULSE_SERVER=unix:/nonexistent/fakexr-no-audio PIPEWIRE_REMOTE=/nonexistent/fakexr-no-audio)
	# no D-Bus session for the test program: it cannot inhibit or wake the desktop's screensaver, post notifications
	# or start services; an unreachable address also stops libdbus from auto-launching a bus (FAKEXR_DBUS=1 keeps it)
	[[ ${FAKEXR_DBUS:-0} == 1 ]] || audio+=(DBUS_SESSION_BUS_ADDRESS=unix:path=/nonexistent/fakexr-no-session-bus)
	exec "${sandbox[@]}" env DISPLAY="$display" SDL_VIDEO_ALLOW_SCREENSAVER=1 "${audio[@]}" "${app_env[@]}" \
		XASH3D_BASEDIR="$root" XDG_CACHE_HOME="$cache" \
		LD_LIBRARY_PATH="$root${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
		XR_RUNTIME_JSON="$json" FAKEXR_CONTROL="$xr_fifo" \
		"${vgl[@]}" "${xash[@]}" "${args[@]}" <"$con_fifo" >>"$log" 2>&1
) &
game_pid=$!
echo "fakexr-run: game pid $game_pid on $display ($game, $([[ $gpu == 1 ]] && echo GPU || echo llvmpipe)$([[ -n $rodir ]] && echo ", live install read-only")$([[ -n ${openvr:-} ]] && echo ", OpenVR via $openvr")), output in $out"

alive() {
	kill -0 "$game_pid" 2>/dev/null || return 1
	# a game stuck printing in a loop must not fill /tmp (Doom 3's SIGFPE handler wrote 420 MB in a minute)
	if (($(stat -c %s "$log" 2>/dev/null || echo 0) > ${FAKEXR_LOG_MAX_MB:-200} * 1048576)); then
		echo "fakexr-run: game log over ${FAKEXR_LOG_MAX_MB:-200} MB, stopping the game (looping output?)" >&2
		kill "$game_pid" 2>/dev/null
		truncate -s "${FAKEXR_LOG_MAX_MB:-200}M" "$log"
		return 1
	fi
}
mark=0
log_since_mark() { tail -c +$((mark + 1)) "$log"; }

# crop helper: python3 + PIL, reads the shot json for panel boxes
crop() {
	python3 -I - "$@" <<'PY'
import json, sys
from PIL import Image
mode, png = sys.argv[1], sys.argv[2]
img = Image.open(png)
if mode == "panel":
    layer, eye, margin = int(sys.argv[3]), sys.argv[4], int(sys.argv[5])
    meta = json.load(open(png[:-4] + ".json"))
    lay = next((l for l in meta["layers"] if l["index"] == layer), None)
    if not lay or lay.get("type") != "quad":
        sys.exit(f"layer {layer} is not a quad in this shot")
    box = lay.get("png_" + eye)
    if not box:
        sys.exit(f"layer {layer} is not in front of the {eye} eye (or not tracked)")
    out = png[:-4] + f".panel{layer}.png"
    x0, y0, x1, y1 = box
    x0, y0, x1, y1 = x0 - margin, y0 - margin, x1 + margin, y1 + margin
else:
    x0, y0, x1, y1 = map(float, sys.argv[3:7])
    out = sys.argv[7]
w, h = img.size
box = (max(0, int(x0)), max(0, int(y0)), min(w, int(x1 + 0.999)), min(h, int(y1 + 0.999)))
if box[2] <= box[0] or box[3] <= box[1]:
    sys.exit(f"box {box} is outside the {w}x{h} image")
img.crop(box).save(out)
print(f"fakexr-run: {out} ({box[2]-box[0]}x{box[3]-box[1]} from {box})")
PY
}

take_shot() {
	local name=$1 opts=$2 file=$out/$1.png
	rm -f "$file" "$out/$name.json"
	printf 'shot %s %s\n' "$file" "$opts" >&3
	for _ in $(seq 1 300); do [[ -f $file ]] && break; alive || break; sleep 0.1; done
	if [[ -f $file ]]; then echo "fakexr-run: $file"; else echo "fakexr-run: shot $name timed out" >&2; return 1; fi
}

# Sense button -> Touch input path (hand component), as the real setup delivers it
sense_input() {
	case $1 in
	cross) echo "right a/click" ;; circle) echo "right b/click" ;;
	square) echo "left x/click" ;; triangle) echo "left y/click" ;;
	l2) echo "left trigger/value" ;; r2) echo "right trigger/value" ;;
	l1) echo "left squeeze/value" ;; r1) echo "right squeeze/value" ;;
	l3) echo "left thumbstick/click" ;; r3) echo "right thumbstick/click" ;;
	menu) echo "left menu/click" ;;
	options|create|ps) echo "none" ;;
	*) return 1 ;;
	esac
}

# runs one directive; returns non-zero on failure
directive() {
	local line=$1 dir=$2 cmd rest
	line=${line//\$OUT/$out}
	[[ -z ${line//[[:space:]]/} || $line == \#* ]] && return 0
	alive || { echo "fakexr-run: game is not running ($line)" >&2; tail -20 "$log" >&2; return 2; }
	read -r cmd rest <<<"$line"
	case $cmd in
	xr) printf '%s\n' "$rest" >&3 ;;
	con) printf '%s\n' "$rest" >&4 ;;
	sleep) sleep "$rest" ;;
	shot)
		local name opts
		read -r name opts <<<"$rest"
		take_shot "$name" "${opts:-both}"
		;;
	zoom)
		# zoom <name> <shot> <layer> [left|right] [px] [margin %]: re-render a panel seen in an earlier shot
		local name from layer eye px margin rect
		read -r name from layer eye px margin <<<"$rest"
		rect=$(python3 -I - "$out/$from.json" "$layer" "${eye:-left}" "${margin:-15}" <<'PY'
import json, sys
meta = json.load(open(sys.argv[1]))
layer, eye, margin = int(sys.argv[2]), sys.argv[3], float(sys.argv[4]) / 100
lay = next((l for l in meta["layers"] if l["index"] == layer), None)
if not lay or not lay.get("png_" + eye):
    sys.exit(f"layer {layer} has no box for the {eye} eye in that shot")
x0, y0, x1, y1 = lay["png_" + eye]
if meta["eyes"] == "both" and eye == "right":
    x0 -= meta["shot_size"][0]; x1 -= meta["shot_size"][0]
# back to normal-shot (eye size) pixels if that shot was itself zoomed
sw, sh = meta["shot_size"]; r = meta["rect"]
fx, fy = (r[2] - r[0]) / sw, (r[3] - r[1]) / sh
x0, x1 = r[0] + x0 * fx, r[0] + x1 * fx
y0, y1 = r[1] + y0 * fy, r[1] + y1 * fy
mx, my = (x1 - x0) * margin, (y1 - y0) * margin
